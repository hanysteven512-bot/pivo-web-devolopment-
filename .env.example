# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL Runtime Environment Variables (injected automatically by AI Studio Cloud SQL Proxy)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""

# Cloud SQL Schema Migration Variables (used by Drizzle Kit)
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Optional: Override initial first-time setup administrator password
INITIAL_ADMIN_PASSWORD=""
